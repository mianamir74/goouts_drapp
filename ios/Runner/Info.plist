<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>UIBackgroundModes</key>
	<array>
		<string>remote-notification</string>
	</array>
	<key>CFBundleURLTypes</key>
	<array>
		<dict>
			<key>CFBundleTypeRole</key>
			<string>Editor</string>
			<key>CFBundleURLSchemes</key>
			<array>
				<string>com.googleusercontent.apps.289872853637-hsn5qkb1g7fehvdelmc1rh18c847fame</string>
			</array>
		</dict>
	</array>
	<!-- ⚠ ADDED 24 August 2026. THESE WERE MISSING ENTIRELY, AND THAT WAS A
	     LIVE CRASH, NOT A GAP FOR THE NEW FEATURE.

	     This app has called image_picker for its registration photographs since
	     it was built (registration_screen.dart, business_registration_screen.dart).
	     When an iOS app touches the camera or the photo library and Info.plist
	     carries no usage description, the system does not deny the request — it
	     TERMINATES THE PROCESS IMMEDIATELY.

	     To the person holding the phone the app simply vanishes at the moment
	     they tap to take their selfie, and nothing reaches Crashlytics that
	     names the cause. Every iOS delivery-driver registration would have
	     died at that step.

	     ⚠ THE TEXT IS SHOWN TO THE USER in the permission dialog and is read by
	     App Review. It must say WHY, specifically. "This app needs camera
	     access" is a rejection. -->
	<key>NSCameraUsageDescription</key>
	<string>GoOuts needs your camera to photograph your identity document and take a verification selfie, so we can confirm who you are before you start delivering.</string>
	<key>NSPhotoLibraryUsageDescription</key>
	<string>GoOuts needs access to your photos so you can choose an existing picture of your identity document or profile photo instead of taking a new one.</string>
	<!-- ⚠ ADDED 6 September 2026. Without this key, Apple holds every
	     TestFlight upload in "Missing Compliance" until someone manually
	     answers the export-compliance question for THAT SPECIFIC BUILD in
	     App Store Connect — the build never appears as testable until then.
	     This app only uses standard HTTPS/TLS (Firebase, REST APIs) and no
	     custom cryptography, which is exempt — same as goouts_host, which
	     already declares this and has never had the problem. -->
	<key>ITSAppUsesNonExemptEncryption</key>
	<false/>
	<key>CADisableMinimumFrameDurationOnPhone</key>
	<true/>
	<key>CFBundleDevelopmentRegion</key>
	<string>$(DEVELOPMENT_LANGUAGE)</string>
	<key>CFBundleDisplayName</key>
	<string>GoOuts Driver</string>
	<key>CFBundleExecutable</key>
	<string>$(EXECUTABLE_NAME)</string>
	<key>CFBundleIdentifier</key>
	<string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
	<key>CFBundleInfoDictionaryVersion</key>
	<string>6.0</string>
	<key>CFBundleName</key>
	<string>GoOuts Driver</string>
	<key>CFBundlePackageType</key>
	<string>APPL</string>
	<key>CFBundleShortVersionString</key>
	<string>$(FLUTTER_BUILD_NAME)</string>
	<key>CFBundleSignature</key>
	<string>????</string>
	<key>CFBundleVersion</key>
	<string>$(FLUTTER_BUILD_NUMBER)</string>
	<key>LSRequiresIPhoneOS</key>
	<true/>
	<key>UIApplicationSceneManifest</key>
	<dict>
		<key>UIApplicationSupportsMultipleScenes</key>
		<false/>
		<key>UISceneConfigurations</key>
		<dict>
			<key>UIWindowSceneSessionRoleApplication</key>
			<array>
				<dict>
					<key>UISceneClassName</key>
					<string>UIWindowScene</string>
					<key>UISceneConfigurationName</key>
					<string>flutter</string>
					<key>UISceneDelegateClassName</key>
					<string>$(PRODUCT_MODULE_NAME).SceneDelegate</string>
					<key>UISceneStoryboardFile</key>
					<string>Main</string>
				</dict>
			</array>
		</dict>
	</dict>
	<key>UIApplicationSupportsIndirectInputEvents</key>
	<true/>
	<key>UILaunchStoryboardName</key>
	<string>LaunchScreen</string>
	<key>UIMainStoryboardFile</key>
	<string>Main</string>
	<key>UISupportedInterfaceOrientations</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
		<string>UIInterfaceOrientationLandscapeLeft</string>
		<string>UIInterfaceOrientationLandscapeRight</string>
	</array>
	<key>UISupportedInterfaceOrientations~ipad</key>
	<array>
